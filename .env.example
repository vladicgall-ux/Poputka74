# Токен бота, выданный @BotFather
BOT_TOKEN=123456:AAABBBCCC...

# Публичный HTTPS-адрес, на котором задеплоено Mini App (папка public/).
# Должен совпадать с URL, который вы укажете в @BotFather -> Bot Settings -> Menu Button / Web App.
WEBAPP_URL=https://your-domain.example.com

# Токен бота MAX, выданный в кабинете разработчика MAX.
# Необязателен: пока переменная не задана, бот MAX не создаётся вовсе и
# никак не влияет на работу Telegram-бота. Нужен и для входа по коду через
# чат с ботом MAX, и для проверки подписи initData из MAX Mini App.
MAX_BOT_TOKEN=

# Порт HTTP-сервера (Express отдаёт и Mini App, и API)
PORT=3000

# telegram_id администраторов через запятую — им доступны служебные команды бота
ADMIN_IDS=

# Путь к файлу базы данных SQLite
DB_PATH=./data/poputka74.db

# --- Безопасность (у всех есть значения по умолчанию, задавать необязательно) ---

# Сколько секунд initData из Telegram/MAX Mini App считается действительной.
# Это окно, в течение которого один раз перехваченная или пересланная
# initData продолжает открывать доступ к аккаунту. Час — обычное
# production-значение: Mini App получает свежую initData при каждом
# запуске, а дальше работает серверная сессия (кука), initData больше не
# нужна. Увеличивать стоит только если пользователи Mini App начали
# получать 401 при долгой работе без перезапуска приложения.
INIT_DATA_MAX_AGE_SEC=3600

# Сколько дней живёт серверная сессия (кука web_session).
SESSION_TTL_DAYS=7

# Сколько доверенных обратных прокси стоит ПЕРЕД приложением.
# Express отсчитывает столько хопов справа в X-Forwarded-For, чтобы
# определить req.ip — по нему работают лимитеры и пишутся логи.
# Значение обязано совпадать с реальной схемой развёртывания:
#   0 — прокси нет, приложение смотрит в интернет напрямую;
#   1 — ровно один прокси (так на bothost и большинстве PaaS) — по умолчанию;
#   2 — например, свой обратный прокси max-proxy/ перед прокси хостинга.
# Если указать больше, чем есть на самом деле, req.ip станет тем адресом,
# который прислал сам клиент, и лимитеры начнут считать по выдуманным
# адресам. Прокси из max-proxy/ со своей стороны затирает клиентский
# X-Forwarded-For адресом сокета, поэтому цепочка остаётся доверенной.
TRUST_PROXY=1
